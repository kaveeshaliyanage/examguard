# Copy to .env on the VPS. Never commit the filled copy.

# Images published by .github/workflows/cd.yml
GHCR_OWNER=kaveeshaliyanage
EXAMGUARD_VERSION=latest

# Only the frontend is published; 80 by default. Put TLS in front of it.
HTTP_PORT=80
CORS_ALLOWED_ORIGINS=https://examguard.example.edu

# Database
DB_VENDOR=mysql
MYSQL_DATABASE=examguard
MYSQL_USER=examguard
MYSQL_PASSWORD=replace-with-a-long-random-value
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-value

# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=replace-with-32-plus-random-characters

# Seeded demo accounts must never exist on a production database.
SEED_DEMO_DATA=false

# First administrator, created on the first boot of an empty database (password >= 12 chars).
# Ignored once any administrator exists: sign in, change the password, then clear these.
BOOTSTRAP_ADMIN_EMAIL=admin@your-domain.example
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
BOOTSTRAP_ADMIN_NAME=Administrator

# Optional shared secret between the backend and the analysis service.
ANALYSIS_TOKEN=

# Exam PIN email. Leave MAIL_ENABLED=false to keep the PIN in the lecturer's one-time response only.
MAIL_ENABLED=false
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=exams@your-domain.example

# Shared secret between the backend and the sandboxed code runner; compose refuses to start
# without it. Generate with: openssl rand -hex 32
RUNNER_TOKEN=replace-with-a-random-runner-token

# Optional learned fusion. Leave false until the models are validated on a consented pilot and
# ai/models contains the artifacts.
USE_LEARNED_FUSION=false
SEMANTIC_ENABLED=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
MODEL_DIR=/app/models

MIN_PAIR_PRIORITY=20
MIN_INCIDENT_PRIORITY=10
