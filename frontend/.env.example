# Copy to frontend/.env.local for `npm run dev`.

# Browser calls same-origin /api; Vite proxies it to the backend.
VITE_API_BASE=/api
VITE_PROXY_TARGET=http://localhost:8080

# Prefill on /join
VITE_DEFAULT_EXAM_CODE=DEMO-101

# Optional: the installed extension ID, so the student page can offer a direct link.
# VITE_EXTENSION_ID=
