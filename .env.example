# Copy to .env and change every secret before use.

# --- MySQL ---
MYSQL_DATABASE=examguard
MYSQL_USER=examguard
MYSQL_PASSWORD=examguard
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_HOST_PORT=3307

# --- Backend ---
JWT_SECRET=change-me-to-at-least-32-random-characters
JWT_STAFF_TTL_MINUTES=480
JWT_ATTEMPT_TTL_MINUTES=360
ANALYSIS_BASE_URL=http://ai:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true
BACKEND_HOST_PORT=8080

# --- AI service ---
SEMANTIC_ENABLED=false
INSTALL_SEMANTIC=false
SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_LEARNED_FUSION=false
MODEL_DIR=/app/models
AI_HOST_PORT=8000
MIN_PAIR_PRIORITY=20
MIN_INCIDENT_PRIORITY=10

# --- Frontend build ---
VITE_API_BASE=/api
VITE_DEFAULT_EXAM_CODE=DEMO-101
FRONTEND_HOST_PORT=5173
